@StockAnalyzer.Api_HostAddress = http://localhost:8080

GET {{StockAnalyzer.Api_HostAddress}}/api/health
Accept: application/json

###

GET {{StockAnalyzer.Api_HostAddress}}/api/stocks/history/RELIANCE.NS?period=5y
Accept: application/json

###

GET {{StockAnalyzer.Api_HostAddress}}/api/stocks/indicators/RELIANCE.NS?period=5y
Accept: application/json

###

GET {{StockAnalyzer.Api_HostAddress}}/api/predictions/rule-based/RELIANCE.NS
Accept: application/json

###

GET {{StockAnalyzer.Api_HostAddress}}/api/predictions/ml/RELIANCE.NS
Accept: application/json
