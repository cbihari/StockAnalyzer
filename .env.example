POSTGRES_DB=stock_analyzer
POSTGRES_USER=stock_user
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5433

FRONTEND_PORT=4200
BACKEND_PORT=8080
ML_SERVICE_PORT=8000
ML_PREDICTION_TIMEOUT_SECONDS=600

ASPNETCORE_ENVIRONMENT=Development
FRONTEND_URL=http://localhost:4200
ML_LOG_LEVEL=INFO
MARKET_DATA_PROVIDER=yahoo
MARKET_DATA_PROVIDER_NAME=yahoo_finance
PAYMENT_PROVIDER=manual
# Optional local/staging override for plan resolution: free, pro, or power.
STOCKANALYZER_PLAN_OVERRIDE=

# AI explanations (passed only to python-ml-service)
AI_EXPLANATIONS_ENABLED=true
LLM_PROVIDER=openai
# For direct local FastAPI runs. Docker Compose reads .secrets/openai_api_key instead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_SECONDS=30
AI_RATE_LIMIT_PER_MINUTE=10
ML_AI_TIMEOUT_SECONDS=45
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
